FROM python:3.11-slim AS builder

WORKDIR /app

# 빌드 시점에만 필요 — 최종 이미지엔 안 들어감 (multi-stage)
RUN apt-get update && apt-get install -y \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt


FROM python:3.11-slim

WORKDIR /app

COPY --from=builder /install /usr/local

COPY app.py config.py chunking.py embeddings.py pipeline.py ./
COPY static ./static
COPY qdrant_data ./qdrant_data

EXPOSE 5000

# Render가 PORT를 주입함(기본 10000) — shell-form이라야 $PORT 치환됨.
# 로컬 compose는 PORT 안 주므로 기본값 5000 유지.
CMD uvicorn app:app --host 0.0.0.0 --port ${PORT:-5000}
